{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "bs-fabric/entry-embed",
    "title": "Fabric-Inhalt",
    "category": "widgets",
    "icon": "layout",
    "description": "Bindet einen oder mehrere bs-fabric-Einträge auf dieser Seite ein.",
    "textdomain": "bs-fabric",
    "attributes": {
        "template": {
            "type": "string",
            "default": ""
        },
        "entryIds": {
            "type": "array",
            "default": [],
            "items": {
                "type": "number"
            }
        },
        "view": {
            "type": "string",
            "default": "card"
        }
    },
    "supports": {
        "html": false
    },
    "editorScript": "file:./index.js"
}
